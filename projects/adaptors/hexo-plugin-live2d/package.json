{
    "name": "hexo-plugin-live2d",
    "version": "0.0.0",
    "description": "Hexo plugin for doki-land live2d.ts — inject widget with renderer fallback (webgpu→webgl2→canvas2d)",
    "license": "MIT",
    "author": "Doki Land",
    "keywords": [
        "hexo",
        "hexo-plugin",
        "live2d",
        "doki-land"
    ],
    "main": "index.cjs",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "require": "./index.cjs",
            "default": "./index.cjs"
        }
    },
    "files": [
        "index.cjs",
        "browser",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node ./scripts/build-browser.mjs",
        "prepublishOnly": "pnpm run build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "hexo": ">=6.0.0"
    },
    "peerDependenciesMeta": {
        "hexo": {
            "optional": true
        }
    },
    "dependencies": {
        "@doki-land/live2d": "workspace:*",
        "@doki-land/live2d-widget": "workspace:*"
    },
    "devDependencies": {
        "esbuild": "^0.25.0",
        "typescript": "^5.8.0",
        "vitest": "^2.1.8"
    },
    "sideEffects": false
}
