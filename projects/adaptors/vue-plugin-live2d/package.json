{
    "name": "vue-plugin-live2d",
    "version": "0.0.0",
    "description": "Vue plugin for @doki-land/live2d — <Live2D> component",
    "type": "module",
    "license": "MIT",
    "author": "Doki Land",
    "keywords": [
        "live2d",
        "vue",
        "plugin",
        "doki-land"
    ],
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "dist",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "peerDependencies": {
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@doki-land/live2d": "workspace:*"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.0",
        "@webgpu/types": "^0.1.64",
        "typescript": "^5.8.0",
        "vite": "8.0.16",
        "vitest": "^2.1.8",
        "vue": "^3.5.0",
        "vue-tsc": "^2.0.0"
    },
    "sideEffects": false
}
