<template>
  <div class="site">
    <SiteHeader />
    <main>
      <header class="page-head">
        <p class="kicker">{kickerLabel}</p>
        <h1>{titleLabel}</h1>
        <p class="lede">{ledeLabel}</p>
      </header>
      <div class="stage-layout">
        <aside class="stage-panel">
          <Select
            label={addLabel}
            controlId="stage-model"
            value={selectedId}
            options={modelOptions}
            onChange={(e) => this.onModelPick(e)}
          />
          <Button type="button" onClick={() => this.addActor()}>{addLabel}</Button>
          <p if={!actorCount}>{emptyLabel}</p>
          <p if={actorCount}>{actorsLabel}: {actorCount}</p>
        </aside>
        <Live2dStage sources={actorSources} updateMode="auto" />
      </div>
    </main>
    <SiteFooter />
  </div>
</template>

<script client>
import {
  stageTitle,
  stageLede,
  stageAdd,
  stageEmpty,
  stageKicker,
  stageActors,
} from '#locales/common';
import { displayNameFor, fetchCatalog, type CatalogModel } from '../lib/catalog.ts';
import {
  readLocaleId,
  watchDocumentLocale,
  withLocaleHint,
} from '../lib/locale-copy.ts';

export default class StagePage {
  kickerLabel = '';
  titleLabel = '';
  ledeLabel = '';
  addLabel = '';
  emptyLabel = '';
  actorsLabel = '';
  selectedId = '';
  modelOptions = [{ value: '', label: '—' }];
  catalogModels: CatalogModel[] = [];
  actorSources = [];
  actorCount = 0;
  _unwatchLocale = null;

  onMount() {
    withLocaleHint(readLocaleId(), () => this.refreshCopy());
    this._unwatchLocale = watchDocumentLocale(() => this.refreshCopy());
    void this.loadCatalog();
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
  }

  refreshCopy() {
    this.kickerLabel = stageKicker();
    this.titleLabel = stageTitle();
    this.ledeLabel = stageLede();
    this.addLabel = stageAdd();
    this.emptyLabel = stageEmpty();
    this.actorsLabel = stageActors();
  }

  async loadCatalog() {
    const catalog = await fetchCatalog();
    this.catalogModels = catalog.models;
    const locale = readLocaleId();
    this.modelOptions = catalog.models.map((m) => ({
      value: m.id,
      label: displayNameFor(m, locale),
    }));
    if (this.modelOptions.length) this.selectedId = this.modelOptions[0].value;
  }

  onModelPick(e) {
    this.selectedId = e?.target?.value ? String(e.target.value) : '';
  }

  addActor() {
    if (!this.selectedId) return;
    const hit = this.catalogModels.find((m) => m.id === this.selectedId);
    if (!hit) return;
    this.actorSources = [...this.actorSources, hit.source];
    this.actorCount = this.actorSources.length;
  }
}
</script>
